# Raw archive of last year's course material lives at ../IF (one level
# up, outside this repo) — personal documents and restricted data live
# there. This rule is a safety net in case it's ever copied back in.
IF/

# European Social Survey data has redistribution restrictions — never publish
data/ESS_2018_all_kurz.dta

# Word embeddings archives/dumps are huge (GBs) and don't belong in git
# history — data/agency_dictionary.txt and communion_dictionary.txt are
# fine, they're tiny; this is specifically for things like GloVe/Dolma
# vector dumps.
data/*.zip
data/*glove*.txt
data/*embeddings*.txt
data/dolma_300_2024_1.2M.100_combined.txt

# Journal-article PDFs: copyright/redistribution rights not confirmed —
# cite and link instead of publishing full text. See notes/day2.qmd for
# how the agency/communion dictionary paper is cited.
lit/

# Quarto
/.quarto/
/_site/
/_freeze/
*_files/
*_cache/

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# macOS
.DS_Store

# Office lock files
~$*

**/*.quarto_ipynb

# Claude Code session state
.claude/
